DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
JWT_SECRET=generate-with-python -c "import secrets; print(secrets.token_hex(32))"
# DEV-ONLY: lets X-Dev-Facility-Id bypass real login for local testing. Never
# set this to true anywhere real users could reach the server.
ALLOW_DEV_FACILITY_OVERRIDE=false
# DEV-ONLY: enables donor-blast test tools (simulate a reply, force a blast's
# deadline into the past) that only exist because there's no real SMS provider
# yet. Never set this to true anywhere real users could reach the server.
ALLOW_DEV_TEST_TOOLS=false
# The deployed frontend's real origin (comma-separated if more than one).
# Defaults to "*" if unset — fine temporarily before the real frontend URL
# is known, but set this once it is (see main.py's CORS_ALLOWED_ORIGINS).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# There is no ADMIN_API_KEY anymore — /admin/* endpoints are gated by a real
# role='admin' account instead (see require_admin_role in main.py). Create
# the first admin with: .venv\Scripts\python.exe seed_admin_user.py <email> <password>

# Resend (https://resend.com) API key — used only to send self-service
# password-reset emails (see /auth/forgot-password). Sign up for their free
# tier (100 emails/day, no card required), grab an API key from the
# dashboard, and set it here. Without it, /auth/forgot-password still returns
# its normal (non-revealing) response but logs an email-send failure instead
# of actually delivering anything.
RESEND_API_KEY=
# Resend's shared sandbox sender — works immediately with no domain setup,
# but can typically only deliver to the email address your Resend account
# itself is registered with until you verify a real sending domain. Switch
# this to an address on your own verified domain once you have one.
RESEND_FROM_EMAIL=BloodLink <onboarding@resend.dev>
# The deployed frontend's own URL, used only to build the link inside a
# password-reset email — e.g. https://your-app.vercel.app. Defaults to local
# dev if unset.
FRONTEND_BASE_URL=http://localhost:5173
